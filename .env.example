# 실제 값은 .env.local에 넣는다 (커밋 금지).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 클라이언트 코드에서 절대 참조하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 공개 사이트 서브도메인의 기준 도메인 (예: onggage.kr)
NEXT_PUBLIC_ROOT_DOMAIN=

# 카카오·구글 로그인 (Supabase CLI가 supabase/config.toml의 env()로 읽는다. 설정: docs/auth-setup.md)
# 로컬은 supabase/.env 에 넣는다. 운영은 Supabase 대시보드에 직접 입력한다.
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
